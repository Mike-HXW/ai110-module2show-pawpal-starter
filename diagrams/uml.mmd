classDiagram
    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +time day_end
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +remove_pet(name) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task_id) void
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str id
        +str title
        +int duration_minutes
        +str priority
        +str category
        +time preferred_time
        +bool completed
        +edit(**fields) void
        +mark_done() void
    }

    class Scheduler {
        +Owner owner
        +build_plan() list~dict~
        +sort_tasks(tasks) list~Task~
        +fits_in_time(task, remaining) bool
        +explain_choice(task) str
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : reads constraints and tasks from
